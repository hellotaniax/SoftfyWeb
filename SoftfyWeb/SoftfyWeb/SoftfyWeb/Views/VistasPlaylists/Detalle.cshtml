@model List<PlaylistCancionDto>
@using SoftfyWeb.Modelos.Dtos

@{
    ViewData["Title"] = "Detalle de Playlist";
}

<div class="container py-5">
    <h2 class="text-center">@ViewData["Title"]</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <!-- Mostrar el nombre de la playlist -->
    <div class="text-center mt-4">
        <h3>@ViewBag.PlaylistNombre</h3>
        <p class="text-muted">Aquí están todas las canciones de esta playlist.</p>
    </div>

    <!-- Título de Canciones en Playlist -->
    <h4 class="mt-4">Canciones en esta playlist</h4>

    <!-- Lista de Canciones -->
    @if (Model.Any())
    {
        <div class="list-group">
            @foreach (var c in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center mb-3 shadow-sm rounded">
                    <div class="d-flex align-items-center">
                        <!-- Título de la Canción -->
                        <strong class="mr-3">@c.Titulo</strong>

                        <!-- Agregar más detalles de la canción (si lo deseas) -->
                        <span class="text-muted small">🎵</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <!-- Reproductor de Audio de Bootstrap -->
                        <audio controls class="ml-3">
                            <source src="@c.UrlArchivo" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">No hay canciones disponibles en esta playlist.</p>
    }
</div>

<!-- Estilos adicionales para mejorar la presentación -->
<style>
    .list-group-item {
        transition: transform 0.2s ease-in-out;
    }

        .list-group-item:hover {
            transform: scale(1.03);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

    .btn-outline-primary {
        transition: background-color 0.2s ease-in-out, color 0.2s ease-in-out;
    }

        .btn-outline-primary:hover {
            background-color: #007bff;
            color: white;
        }
</style>
